erDiagram
    %% Forma: cluster sem fato (não é estrela nem snowflake)
    %% Nenhuma tabela fct_ neste componente — são apenas dim_ ligadas entre si, sem um fato no centro..

    dim_operation }o--|| dim_process : "process_id"

    dim_operation {
        VARCHAR operation_id PK
        VARCHAR id
        TIMESTAMP completed_at
        VARCHAR process_id  FK
        VARCHAR site
        TIMESTAMP start_at
    }
    dim_process {
        VARCHAR process_id PK
        VARCHAR id
    }