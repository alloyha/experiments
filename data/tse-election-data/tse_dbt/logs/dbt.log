  create view "tse_analytics"."main"."candidate_tally_reconciliation__dbt_tmp" as (
    

with coverage as (
    select *
    from "tse_analytics"."main"."int_candidate_result_coverage"
),

candidate as (
    select
        election_year,
        election_type,
        election_code,
        round_number,
        uf,
        municipality_code,
        zone,
        office_code,
