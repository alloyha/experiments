      "stg_party_votes_raw__dbt_tmp_8078c446_359e_4f38_9358_c07cb77c3d22"
  
    as (
      

with src as (
    select *
    from 
  
    
    
    (
      with _index as (
        select distinct
          '/home/pingu/github/experiments/data/tse-election-data/data/tse' || '/' || object as object_path,
          year as _index_year,
