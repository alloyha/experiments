FROM python:3.11-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Install uv (fast dependency resolver)
RUN pip install --no-cache-dir uv

# Copy pyproject.toml (single source of truth)
COPY pyproject.toml .

# Install flink-consumer dependencies (includes Kafka and Iceberg)
RUN uv pip install --system '.[flink-consumer]'

# Copy scripts
COPY scripts/flink_stream_consumer.py .
COPY scripts/entrypoint-flink-consumer.sh .

# Create logs directory
RUN mkdir -p /app/logs && chmod +x /app/entrypoint-flink-consumer.sh

# Entrypoint
ENTRYPOINT ["/app/entrypoint-flink-consumer.sh"]
