# Example: DBT Flink Dockerfile with uv
# Build: docker build -f Dockerfile.dbt-flink.example -t cdc-dbt-flink-ingestao .
# For Kafka CDC -> Iceberg streaming (Bronze -> Silver)

FROM python:3.10-slim

WORKDIR /dbt

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git curl postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy pyproject.toml (single source of truth)
COPY pyproject.toml .

# Install uv and dependencies for dbt-flink only
RUN pip install --no-cache-dir uv && \
    uv pip install --system '.[dbt-flink]'

# Copy dbt project and configuration
COPY dbt/ .
COPY dbt/profiles.yml /root/.dbt/
COPY healthcheck-dbt.sh /usr/local/bin/healthcheck-dbt.sh
RUN chmod +x /usr/local/bin/healthcheck-dbt.sh

# Environment
ENV DBT_PROFILES_DIR=/root/.dbt
ENV PYTHONUNBUFFERED=1

# Use bash for flexibility with dbt commands
ENTRYPOINT ["/bin/bash", "-c"]
CMD ["dbt --version"]

# Healthcheck (updated for new script)
HEALTHCHECK --interval=60s --timeout=20s --start-period=60s --retries=2 \
    CMD /usr/local/bin/healthcheck-dbt.sh
