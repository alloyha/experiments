# Flink runtime with Kafka + Iceberg connectors baked in.
# Shared by jobmanager, taskmanager and sql-gateway (same classpath needed by all three).
#
# Iceberg catalog uses the JDBC catalog (backed by Postgres) + Iceberg's own
# native S3FileIO for data files -- deliberately avoids the Hadoop catalog /
# hadoop-common+hadoop-aws path, which pulls in a large, version-fragile
# Hadoop classpath that conflicted with Flink's own shaded Hadoop utilities.

FROM flink:1.17-scala_2.12-java11

RUN curl -fSL -o /opt/flink/lib/flink-sql-connector-kafka-1.17.2.jar \
       https://repo1.maven.org/maven2/org/apache/flink/flink-sql-connector-kafka/1.17.2/flink-sql-connector-kafka-1.17.2.jar \
    && curl -fSL -o /opt/flink/lib/iceberg-flink-runtime-1.17-1.5.2.jar \
       https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-flink-runtime-1.17/1.5.2/iceberg-flink-runtime-1.17-1.5.2.jar \
    && curl -fSL -o /opt/flink/lib/postgresql-42.7.3.jar \
       https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.3/postgresql-42.7.3.jar \
    && curl -fSL -o /opt/flink/lib/hadoop-common-3.3.4.jar \
       https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-common/3.3.4/hadoop-common-3.3.4.jar \
    && curl -fSL -o /opt/flink/lib/hadoop-hdfs-client-3.3.4.jar \
       https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-hdfs-client/3.3.4/hadoop-hdfs-client-3.3.4.jar \
    && curl -fSL -o /opt/flink/lib/woodstox-core-5.3.0.jar \
       https://repo1.maven.org/maven2/com/fasterxml/woodstox/woodstox-core/5.3.0/woodstox-core-5.3.0.jar \
    && curl -fSL -o /opt/flink/lib/stax2-api-4.2.1.jar \
       https://repo1.maven.org/maven2/org/codehaus/woodstox/stax2-api/4.2.1/stax2-api-4.2.1.jar \
    && curl -fSL -o /opt/flink/lib/hadoop-shaded-guava-1.1.1.jar \
       https://repo1.maven.org/maven2/org/apache/hadoop/thirdparty/hadoop-shaded-guava/1.1.1/hadoop-shaded-guava-1.1.1.jar \
    && curl -fSL -o /opt/flink/lib/iceberg-aws-bundle-1.5.2.jar \
       https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-aws-bundle/1.5.2/iceberg-aws-bundle-1.5.2.jar
